{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolRecap Project Schema v3",
  "type": "object",
  "required": ["schema_version", "project_id", "project_name", "sources", "outputs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "3.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "project_name": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_entry"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      }
    }
  },
  "$defs": {
    "source_entry": {
      "type": "object",
      "required": ["source_file"],
      "additionalProperties": false,
      "properties": {
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint": {
          "type": "object",
          "properties": {
            "basename": {"type": "string"},
            "path": {"type": "string"},
            "size_bytes": {"type": "integer", "minimum": 0},
            "mtime_ns": {"type": "integer"},
            "sha256": {"type": "string"},
            "extension": {"type": "string"}
          },
          "required": ["basename", "path", "size_bytes", "mtime_ns", "sha256", "extension"],
          "additionalProperties": false
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["render_id", "title", "segments"],
      "additionalProperties": false,
      "properties": {
        "render_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/segment"
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "required": [
        "segment_id",
        "source_file",
        "start_ms",
        "end_ms",
        "type",
        "narration",
        "source_audio",
        "subtitles"
      ],
      "additionalProperties": false,
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "enum": ["narration", "original_dialogue"]
        },
        "narration": {
          "type": "string"
        },
        "source_audio": {
          "type": "boolean"
        },
        "narration_duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "subtitles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subtitle_cue"
          }
        }
      }
    },
    "subtitle_cue": {
      "type": "object",
      "required": ["start_ms", "end_ms", "text"],
      "additionalProperties": false,
      "properties": {
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
